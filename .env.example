# Copy to .env and edit. Olde doesn't read this file itself; load it into the
# shell first:  set -a; . ./.env; set +a
# .env is git-ignored, so the key stays out of the repo.

# Needed for the default Claude provider. Not needed with Ollama.
ANTHROPIC_API_KEY=

# Optional settings, shown with their defaults. Uncomment one to change it.
# FEED_URL=https://www.whitehouse.gov/news/feed/
# OLDE_PROVIDER=claude
# OLDE_MODEL=claude-haiku-5-5    # qwen3.5:4b when OLDE_PROVIDER=ollama
# OLDE_OLLAMA_URL=http://localhost:11434
# OLDE_STATE=.cache/olde.json    # relative to the project folder by default
